# The one setting the tool needs.
#
# On GitHub: add it as a repository secret called CARTO_BASEMAP_KEY
# (Settings, Secrets and variables, Actions). The publishing workflow
# passes it to the build. Never commit the real key.
#
# On your own computer: create a file called .env next to package.json
# with the line below and your key. The .gitignore file stops it from
# being uploaded.

VITE_CARTO_BASEMAP_KEY=
